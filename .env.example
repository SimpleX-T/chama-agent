# Shared env vars (copy to .env, never commit)

# Deployer / agent wallet — used by both contracts deploy and the agent cron
# Generate via: pnpm --filter @chama/contracts gen-wallet
# Fund via: https://faucet.celo.org/celo-sepolia  (gets CELO-S for gas)
DEPLOYER_PRIVATE_KEY=0x

# Test member wallets (also generated by gen-wallet)
# Each member needs ~0.05 CELO-S from the faucet for their one-time approve() tx
MEMBER1_PRIVATE_KEY=0x
MEMBER1_ADDRESS=0x
MEMBER2_PRIVATE_KEY=0x
MEMBER2_ADDRESS=0x
MEMBER3_PRIVATE_KEY=0x
MEMBER3_ADDRESS=0x

# Celo Sepolia testnet (verified 2026-05-23)
CELO_SEPOLIA_RPC=https://11142220.rpc.thirdweb.com
CELO_SEPOLIA_CHAIN_ID=11142220

# Celo mainnet — comma-separated list for viem fallback transport
CELO_RPC=https://forno.celo.org,https://rpc.ankr.com/celo
CELO_CHAIN_ID=42220

# cUSD addresses
CUSD_SEPOLIA=0x
CUSD_MAINNET=0x765DE816845861e75A25fCA122bb6898B8B1282a

# Celoscan API key for contract verification
CELOSCAN_API_KEY=

# ERC-8004 Identity Registry address on Celo (fill from 8004scan)
ERC8004_REGISTRY=0x
